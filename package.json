{
	"name": "mxwatch",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "bun run i18n && next dev",
		"build": "bun run i18n && next build",
		"start": "next start",
		"build:cf": "bun run i18n && opennextjs-cloudflare build",
		"preview": "opennextjs-cloudflare preview",
		"dev:full": "bun run build:cf && bun run preview",
		"deploy": "bun run i18n && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
		"cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
		"lint": "biome check --write .",
		"check": "biome ci .",
		"typecheck": "bun run i18n && tsc --noEmit",
		"check:i18n": "inlang check --project ./project.inlang",
		"i18n": "paraglide-js compile --project ./project.inlang"
	},
	"dependencies": {
		"@tanstack/react-query": "^5.107.1",
		"@types/topojson-client": "^3.1.5",
		"@visx/geo": "^4.0.0",
		"d3-geo": "^3.1.1",
		"framer-motion": "^14.9.0",
		"next": "^16.4.3",
		"next-themes": "^0.4.6",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-window": "^2.5.2",
		"topojson-client": "^3.1.0",
		"zod": "^4.6.7",
		"zustand": "^5.0.16"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.4",
		"@inlang/paraglide-js": "^2.29.3",
		"@opennextjs/cloudflare": "^1.20.15",
		"@tailwindcss/postcss": "^4.3.3",
		"@types/d3-geo": "^3.1.1",
		"@types/geojson": "^7946.0.16",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"wrangler": "^4.156.0",
		"@inlang/cli": "^3.4.0"
	},
	"ignoreScripts": [
		"sharp",
		"unrs-resolver"
	],
	"trustedDependencies": [
		"sharp",
		"unrs-resolver"
	]
}
